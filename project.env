# Project identity - the ONE place a student edits to rename the project.
# Read by every script in this repo (scripts\load-env-windows.bat,
# scripts/load-env-linux.sh, scripts/assemble.py) and by the CI workflow.
# Format: KEY=VALUE, no spaces around "=", no quotes. Lines starting with # are comments.
PROJECT_NAME=calculator
VERSION=1.1.0
# owner/repository on GitHub (used for release links and the site's landing page)
GITHUB_REPO=ucoruh/eclipse-java-maven-template
